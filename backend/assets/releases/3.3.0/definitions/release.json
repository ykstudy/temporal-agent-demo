      "contract_version": "1.4.0",
      "skill_id": "add_logging",
      "skill_version": "3.3.0",
      "skill_hash": "5678c7e4fbdf4438b53d93ca3abc91b13cdf04c19bf6665042c51acdd753743f",
      "name": "结构化日志",
      "description": "默认console/json/info，file仅受控logs目录并有轮转与故障策略。",
      "supported_stacks": [
        "golang"
      ],
      "parameters_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "log_level": {
            "default": "info",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ],
            "type": "string"
          },
          "log_format": {
            "default": "json",
            "enum": [
              "json",
              "text"
            ],
            "type": "string"
          },
          "log_output": {
            "default": "console",
            "enum": [
              "console",
              "file"
            ],
            "type": "string"
          },
          "log_path": {
            "default": "logs/app.log",
            "pattern": "^logs/[A-Za-z0-9._/-]+$",
            "type": "string"
          },
          "log_max_size": {
            "default": 10485760,
            "maximum": 1073741824,
            "minimum": 1048576,
            "type": "integer"
          },
          "log_max_backups": {
            "default": 3,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "log_max_age": {
            "default": "168h",
            "maxLength": 64,
            "minLength": 2,
            "type": "string"
          },
          "log_on_write_error": {
            "default": "degrade",
            "enum": [
              "degrade",
              "fail_closed"
            ],
            "type": "string"
          }
        },
        "required": [
          "log_level",
          "log_format",
          "log_output",
          "log_path",
          "log_max_size",
          "log_max_backups",
          "log_max_age",
          "log_on_write_error"
        ]
      },
      "default_parameters": {
        "log_format": "json",
        "log_level": "info",
        "log_max_age": "168h",
        "log_max_backups": 3,
        "log_max_size": 10485760,
