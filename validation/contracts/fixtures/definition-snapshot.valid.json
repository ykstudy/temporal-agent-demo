      "description": "默认console/json/info，file仅受控logs目录并有轮转与故障策略。",
      "supported_stacks": [
        "golang"
      ],
      "parameters_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "log_level": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ],
            "default": "info"
          },
          "log_format": {
            "type": "string",
            "enum": [
              "json",
              "text"
            ],
            "default": "json"
          },
          "log_output": {
            "type": "string",
            "enum": [
              "console",
              "file"
            ],
            "default": "console"
          },
          "log_path": {
            "type": "string",
            "pattern": "^logs/[A-Za-z0-9._/-]+$",
            "default": "logs/app.log"
          },
          "log_max_size": {
            "type": "integer",
            "minimum": 1048576,
            "maximum": 1073741824,
            "default": 10485760
          },
          "log_max_backups": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 3
          },
          "log_max_age": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "default": "168h"
          },
          "log_on_write_error": {
            "type": "string",
            "enum": [
              "degrade",
              "fail_closed"
            ],
            "default": "degrade"
          }
        },
        "required": [
          "log_level",
          "log_format",
          "log_output",
          "log_path",
          "log_max_size",
          "log_max_backups",
          "log_max_age",
          "log_on_write_error"
        ]
      },
      "default_parameters": {
        "log_level": "info",
        "log_format": "json",
        "log_output": "console",
        "log_path": "logs/app.log",
        "log_max_size": 10485760,
        "log_max_backups": 3,
        "log_max_age": "168h",
        "log_on_write_error": "degrade"
      },
